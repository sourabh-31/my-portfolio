---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/globals.css";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font preload cssVariable="--font-archivo" />
    <Font preload cssVariable="--font-space-grotesk" />
    <Font preload cssVariable="--font-geist-mono" />
    <title>Sourabh Haldar</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      if (localStorage.getItem("theme") === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body class="font-sans text-pretty">
    <div class="relative min-h-screen">
      <div class="relative z-[1]">
        <Header />

        <main
          class="mx-auto max-w-180 px-6 pt-18 pb-8 max-[640px]:px-5 max-[640px]:pt-11 max-[640px]:pb-10"
        >
          <slot />
          <Footer />
        </main>
      </div>
    </div>
  </body>
</html>

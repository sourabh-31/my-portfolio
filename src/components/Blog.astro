---
import { Image } from "astro:assets";
import { BLOG_POSTS } from "../data/site";

const [featured, ...rest] = BLOG_POSTS;
---

<header class="flex flex-col gap-4.5 pb-11">
  <h1
    class="font-heading ml-[-0.04em] max-w-[16ch] text-[clamp(38px,6vw,58px)] leading-[1.04] font-bold tracking-tight"
  >
    Welcome to the blog
  </h1>
  <p class="max-w-[60ch] text-[17px] leading-7 text-ink/80">
    This is where I write about the things I am learning, building, and
    exploring. Some articles are technical, others are practical, but they are
    all written with the hope that someone else finds them useful.
  </p>
</header>

<div class="flex items-center gap-3.5 pb-5">
  <span aria-hidden="true" class="bg-accent h-2 w-2 shrink-0"></span>
  <span
    class="font-heading text-[10.5px] font-semibold tracking-[0.16em] text-ink/45 uppercase"
  >
    Latest
  </span>
  <span class="h-px flex-1 bg-ink/28"></span>
</div>

<a
  href={`/blog/${featured.slug}`}
  class="group grid grid-cols-1 items-start gap-5.5 pb-11 md:grid-cols-[minmax(0,0.78fr)_minmax(0,1fr)] md:gap-7"
>
  <Image
    src={featured.img}
    alt="featured"
    loading="eager"
    decoding="async"
    quality="mid"
    class="rounded-lg"
  />
  <div class="flex min-w-0 flex-col">
    <span
      class="font-heading text-[clamp(27px,3.3vw,37px)] leading-[1.1] font-bold tracking-[-0.024em] group-hover:text-accent"
    >
      {featured.title}
    </span>
    <span class="mt-4 text-ink/80">
      {featured.excerpt}
    </span>
    <span
      class="font-heading mt-5.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11px] font-semibold tracking-[0.14em] text-ink/45 uppercase"
    >
      <span>{featured.date}</span>
      <span aria-hidden="true" class="h-1 w-1 bg-current"></span>
      <span>{featured.tags.join(" · ")}</span>
      <span aria-hidden="true" class="h-1 w-1 bg-current"></span>
      <span>{featured.read} read</span>
    </span>
    <span
      class="font-heading mt-6.5 inline-flex items-center gap-2.5 self-start border-b-2 border-ink/35 pb-1.25 text-[11.5px] font-bold tracking-[0.12em] uppercase group-hover:text-accent"
    >
      Read the piece
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</a>

<div class="flex items-center gap-3.5 pt-2 pb-1.5">
  <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-ink/25"></span>
  <span
    class="font-heading text-[10.5px] font-semibold tracking-[0.16em] text-ink/45 uppercase"
  >
    Earlier
  </span>
  <span class="h-px flex-1 bg-ink/20"></span>
</div>

{
  rest.map((post, index) => (
    <a
      href={`/blog/${post.slug}`}
      class="group grid grid-cols-1 items-stretch gap-3 py-6.5  sm:grid-cols-[190px_minmax(0,1fr)_26px] sm:gap-6.5"
    >
      <Image
        src={post.img}
        alt={post.title}
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        quality="mid"
        class="rounded-lg"
      />
      <div class="flex min-w-0 flex-col gap-2.25">
        <span class="font-heading text-[21px] leading-[1.26] font-bold tracking-[-0.015em] group-hover:text-accent">
          {post.title}
        </span>
        <span class=" text-[15px] leading-6.25 text-ink/80">
          {post.excerpt}
        </span>
        <span class="font-heading flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[10.5px] font-semibold tracking-[0.1em] text-ink/45 uppercase">
          <span>{post.date}</span>
          <span aria-hidden="true" class="h-1 w-1 bg-current" />
          <span>{post.tags.join(" · ")}</span>
          <span aria-hidden="true" class="h-1 w-1 bg-current" />
          <span>{post.read} read</span>
        </span>
      </div>
    </a>
  ))
}

<div
  class="font-heading flex items-center gap-3.5 pt-11.5 text-[11.5px] font-semibold tracking-[0.1em] text-ink/45 uppercase"
>
  <span class="h-px flex-1 bg-ink/20"></span>
  End of archive
  <span class="h-px flex-1 bg-ink/20"></span>
</div>

---
import { ABOUT, SITE } from "../data/site";
---

<section class="max-w-3xl mx-auto px-6 md:px-10 pt-16 md:pt-24">
  <p class="font-mono-ui text-[11px] uppercase tracking-wider text-muted mb-6">
    About
  </p>
  <h1
    class="font-display text-[44px] leading-[1.02] md:text-[64px] md:leading-[1.02] text-fg"
  >
    {ABOUT.intro}
  </h1>

  <div
    class="mt-8 space-y-5 text-[16px] md:text-[17px] leading-[1.75] text-fg/90"
  >
    {ABOUT.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <div class="mt-14">
    <p
      class="font-mono-ui text-[11px] uppercase tracking-wider text-muted mb-4"
    >
      A few things I believe
    </p>
    <div class="grid sm:grid-cols-2 gap-4">
      {
        ABOUT.principles.map((pr) => (
          <div class="principle-card p-5 rounded-xl border border-border">
            <p class="font-display text-xl text-fg">{pr.title}</p>
            <p class="text-sm text-muted leading-relaxed mt-1.5">{pr.body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-14">
    <p
      class="font-mono-ui text-[11px] uppercase tracking-wider text-muted mb-4"
    >
      Tools I reach for
    </p>
    <div class="flex flex-wrap gap-2">
      {
        ABOUT.stack.map((s) => (
          <span class="inline-flex items-center h-8 px-3 rounded-full border border-border bg-surface text-[12px] font-mono-ui text-fg">
            {s}
          </span>
        ))
      }
    </div>
  </div>

  <div class="mt-14">
    <p
      class="font-mono-ui text-[11px] uppercase tracking-wider text-muted mb-4"
    >
      A short timeline
    </p>
    <ol>
      {
        ABOUT.timeline.map((t) => (
          <li class="grid grid-cols-[64px_1fr] items-baseline md:items-center gap-4 py-4 border-t border-border last:border-b">
            <span class="font-mono-ui text-[12px] text-muted tabular-nums">
              {t.year}
            </span>
            <span class="text-[15px] text-fg">{t.what}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mt-14 p-6 rounded-2xl bg-accent-soft border border-border">
    <p class="font-display text-2xl leading-snug text-fg">
      Working on something? I'd love to hear about it.
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="inline-block mt-3 font-mono-ui text-sm link-underline-on text-fg"
    >
      {SITE.email}
    </a>
  </div>
</section>

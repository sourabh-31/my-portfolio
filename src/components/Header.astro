---
import { SITE } from "../data/site";
import logo from "../assets/logo.svg";

const pathname = Astro.url.pathname;
const isBlogPage = pathname.startsWith("/blog");
const navHref = isBlogPage ? "/" : "/blog";
const navLabel = isBlogPage ? "Portfolio" : "Blog";
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-40 h-0.75"
>
  <div id="scroll-progress-bar" class="bg-accent h-full w-0"></div>
</div>

<nav
  aria-label="Primary"
  class="font-heading relative flex items-center gap-3.5 px-4 pt-5 text-[13px] font-medium sm:px-6 sm:pt-7"
>
  <a href="/" aria-label="Home" class="inline-flex shrink-0 items-center">
    <img src={logo.src} alt="" width="34" height="34" />
  </a>
  <a
    href="/"
    class="text-ink hover:text-accent flex flex-col gap-px leading-[1.15]"
  >
    <span class="text-sm font-bold tracking-[-0.005em]">Sourabh Haldar</span>
    <span class="text-ink/55 text-[11px] font-medium tracking-[0.02em]"
      >Frontend Engineer</span
    >
  </a>

  <span
    class="border-ink/22 text-ink/72 ml-auto hidden items-center overflow-hidden rounded-[10px] border-2 sm:flex"
  >
    <a
      href={navHref}
      class="border-ink/22 hover:bg-ink/6 hover:text-accent border-r-2 px-3.25 py-1.75 transition-colors duration-120 ease-[ease]"
    >
      {navLabel}
    </a>
    <a
      href={SITE.githubHref}
      target="_blank"
      rel="noopener noreferrer"
      class="border-ink/22 hover:bg-ink/6 hover:text-accent border-r-2 px-3.25 py-1.75 transition-colors duration-120 ease-[ease]"
    >
      GitHub
    </a>
    <a
      href={SITE.linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
      class="border-ink/22 hover:bg-ink/6 hover:text-accent border-r-2 px-3.25 py-1.75 transition-colors duration-120 ease-[ease]"
    >
      LinkedIn
    </a>
    <button
      type="button"
      aria-label="Toggle theme"
      class="theme-toggle text-ink hover:bg-ink/6 flex w-9 shrink-0 cursor-pointer items-center justify-center self-stretch border-0 bg-transparent p-0 transition-colors duration-120 ease-[ease]"
    >
      <svg
        class="icon-sun"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
        ></path>
      </svg>
      <svg
        class="icon-moon hidden"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>
  </span>

  <button
    type="button"
    id="menu-burger"
    aria-label="Menu"
    aria-expanded="false"
    class="border-ink/22 text-ink ml-auto flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] border-2 bg-transparent p-0 sm:hidden"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <div
    id="mobile-menu"
    class="absolute top-full right-4 z-40 mt-2.5 hidden min-w-47.5 sm:right-6"
  >
    <div
      class="bg-ink absolute inset-0 translate-x-1.25 translate-y-1.25 rounded-xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="border-ink bg-paper relative overflow-hidden rounded-xl border-2"
    >
      <a
        href={navHref}
        class="border-ink/15 text-ink hover:bg-ink/6 hover:text-accent block border-b-2 px-4 py-3"
      >
        {navLabel}
      </a>
      <a
        href={SITE.githubHref}
        target="_blank"
        rel="noopener noreferrer"
        class="border-ink/15 text-ink hover:bg-ink/6 hover:text-accent block border-b-2 px-4 py-3"
      >
        GitHub
      </a>
      <a
        href={SITE.linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        class="border-ink/15 text-ink hover:bg-ink/6 hover:text-accent block border-b-2 px-4 py-3"
      >
        LinkedIn
      </a>
      <button
        type="button"
        class="theme-toggle text-ink hover:bg-ink/6 flex w-full cursor-pointer items-center gap-2.5 border-0 bg-transparent px-4 py-3 text-left"
      >
        <span class="theme-toggle-label-light">Light</span><span
          class="theme-toggle-label-dark hidden">Dark</span
        > mode
      </button>
    </div>
  </div>
</nav>

<style>
  :global(html.dark) .icon-sun {
    display: none;
  }
  :global(html.dark) .icon-moon {
    display: block;
  }
  :global(html.dark) .theme-toggle-label-light {
    display: none;
  }
  :global(html.dark) .theme-toggle-label-dark {
    display: inline;
  }
</style>

<script>
  document.querySelectorAll(".theme-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "light" : "dark");
      document.documentElement.classList.toggle("dark", !isDark);
    });
  });

  // Mobile menu
  const burger = document.getElementById("menu-burger");
  const menu = document.getElementById("mobile-menu");

  burger?.addEventListener("click", (e) => {
    e.stopPropagation();
    const open = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", !open);
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });

  document.addEventListener("click", (e) => {
    if (!menu || menu.classList.contains("hidden")) return;
    if (menu.contains(e.target as Node) || burger?.contains(e.target as Node))
      return;
    menu.classList.add("hidden");
    burger?.setAttribute("aria-expanded", "false");
  });

  // Scroll progress bar
  const bar = document.getElementById("scroll-progress-bar");

  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;

    if (bar) bar.style.width = `${(ratio * 100).toFixed(2)}%`;
  }

  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("resize", updateProgress);
  updateProgress();
</script>

---
import { SITE } from "../data/site";
import logo from "../assets/logo.svg";

const pathname = Astro.url.pathname;
const isBlogPage = pathname.startsWith("/blog");
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-40 h-0.75"
>
  <div id="scroll-progress-bar" class="bg-accent h-full w-0"></div>
</div>

<nav
  aria-label="Elsewhere"
  class="font-heading flex items-center gap-2 px-4 pt-5 text-xs font-medium sm:gap-5 sm:px-6 sm:pt-7 sm:text-sm"
>
  <a href="/" aria-label="Home" class="inline-flex items-center pr-1 sm:pr-2">
    <img src={logo.src} alt="" width="34" height="34" />
  </a>
  <a
    href={isBlogPage ? "/" : "/blog"}
    class="hover:text-accent inline-flex items-center gap-1.25 no-underline"
  >
    {isBlogPage ? "Portfolio" : "Blog"}
    <svg
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 7h10v10"></path>
      <path d="M7 17 17 7"></path>
    </svg>
  </a>
  <a
    href={SITE.githubHref}
    class="hover:text-accent inline-flex items-center gap-1.25 no-underline"
    target="_blank"
    rel="noopener noreferrer"
  >
    GitHub
    <svg
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 7h10v10"></path>
      <path d="M7 17 17 7"></path>
    </svg>
  </a>
  <a
    href={SITE.linkedinHref}
    class="hover:text-accent inline-flex items-center gap-1.25 no-underline"
    target="_blank"
    rel="noopener noreferrer"
  >
    LinkedIn
    <svg
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 7h10v10"></path>
      <path d="M7 17 17 7"></path>
    </svg>
  </a>
  <button
    type="button"
    id="theme-toggle"
    aria-label="Toggle theme"
    class="border-ink text-ink relative ml-auto inline-flex cursor-pointer items-center gap-2 border-2 bg-transparent px-2 py-1.75 text-[12px] tracking-[0.06em] uppercase transition-[translate,box-shadow] duration-120 ease-[ease] will-change-transform before:absolute before:-inset-0.5 before:content-[''] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_var(--color-accent)] sm:px-3 rounded-md"
  >
    <svg
      id="icon-sun"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
      ></path>
    </svg>
    <svg
      id="icon-moon"
      class="hidden"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
    <span class="hidden sm:inline">
      <span id="theme-toggle-label-dark" class="hidden">Dark</span>
      <span id="theme-toggle-label-light">Light</span>
    </span>
  </button>
</nav>

<style>
  :global(html.dark) #icon-sun {
    display: none;
  }
  :global(html.dark) #icon-moon {
    display: block;
  }
  :global(html.dark) #theme-toggle-label-light {
    display: none;
  }
  :global(html.dark) #theme-toggle-label-dark {
    display: inline;
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "light" : "dark");
    document.documentElement.classList.toggle("dark", !isDark);
  });

  // Scroll progress bar
  const bar = document.getElementById("scroll-progress-bar");

  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;

    if (bar) bar.style.width = `${(ratio * 100).toFixed(2)}%`;
  }

  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("resize", updateProgress);
  updateProgress();
</script>

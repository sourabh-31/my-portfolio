---
import { Image } from "astro:assets";
import { PROJECTS } from "../data/site";

const WHITE_KEYS = [
  { note: "C4", freq: 261.63, label: "A" },
  { note: "D4", freq: 293.66, label: "S" },
  { note: "E4", freq: 329.63, label: "D" },
  { note: "F4", freq: 349.23, label: "F" },
  { note: "G4", freq: 392.0, label: "G" },
  { note: "A4", freq: 440.0, label: "H" },
  { note: "B4", freq: 493.88, label: "J" },
  { note: "C5", freq: 523.25, label: "K" },
  { note: "D5", freq: 587.33, label: "L" },
  { note: "E5", freq: 659.25, label: ";" },
];

const BLACK_KEYS = [
  { note: "C#4", freq: 277.18, after: 0, label: "W" },
  { note: "D#4", freq: 311.13, after: 1, label: "E" },
  { note: "F#4", freq: 369.99, after: 3, label: "T" },
  { note: "G#4", freq: 415.3, after: 4, label: "Y" },
  { note: "A#4", freq: 466.16, after: 5, label: "U" },
  { note: "C#5", freq: 554.37, after: 7, label: "O" },
  { note: "D#5", freq: 622.25, after: 8, label: "P" },
];

const whiteWidthPct = 100 / WHITE_KEYS.length;
---

<!-- Hero -->
<section class="max-w-3xl mx-auto px-6 md:px-10 pt-24 md:pt-36">
  <div>
    <h1
      class="font-display text-[32px] leading-[1.3] md:text-[44px] md:leading-tight text-fg tracking-tight"
    >
      <a href="/about" class="font-semibold link-underline-on">Sourabh Haldar</a
      >{" "}
      is a frontend-focused software engineer who cares about how things look and
      feel.{" "}
      <span class="text-muted">Currently</span>{" "}
      builds for web and mobile, mostly with music playing in the background.
    </h1>
  </div>

  <div class="mt-14 md:mt-20 select-none" id="hero-piano">
    <div class="flex items-center justify-between gap-3 mb-3">
      <span
        class="font-mono-ui text-[11px] uppercase tracking-wider text-muted"
      >
        a playful thing
      </span>
      <span class="font-mono-ui text-[11px] text-muted hidden sm:inline">
        click keys or tap A-L on your keyboard
      </span>
    </div>

    <div
      class="relative h-44 md:h-52 rounded-lg bg-surface border border-border overflow-hidden transition-colors duration-400"
      aria-label="Playable jazz piano"
    >
      <div class="absolute inset-0 flex">
        {
          WHITE_KEYS.map((key) => (
            <button
              type="button"
              class="relative flex-1 border-r last:border-r-0 border-border flex items-end justify-center pb-3 bg-transparent hover:bg-surface-2 data-[active=true]:bg-accent-soft transition-colors duration-400 data-[active=true]:duration-150"
              data-piano-key
              data-note={key.note}
              data-freq={key.freq}
              aria-label={key.note}
            >
              <span class="font-mono-ui text-[10px] text-muted transition-colors duration-400">
                {key.label}
              </span>
            </button>
          ))
        }
      </div>

      <div class="absolute inset-0 pointer-events-none">
        {
          BLACK_KEYS.map((key) => {
            const left = (key.after + 1) * whiteWidthPct;

            return (
              <button
                type="button"
                class="pointer-events-auto absolute top-0 h-[60%] w-7 sm:w-8 -translate-x-1/2 rounded-b-md bg-fg data-[active=true]:bg-accent text-[10px] font-mono-ui text-bg flex items-end justify-center pb-1 transition-colors duration-400 data-[active=true]:duration-150"
                style={`left: ${left}%;`}
                data-piano-key
                data-note={key.note}
                data-freq={key.freq}
                aria-label={key.note}
              >
                {key.label}
              </button>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<!-- Projects -->
<section
  id="projects"
  class="max-w-5xl mx-auto px-6 md:px-10 mt-16 md:mt-24 pt-4 md:pt-12"
>
  <div class="flex items-end justify-between mb-8">
    <div>
      <p class="font-mono-ui text-[11px] uppercase tracking-wider text-muted">
        Projects
      </p>
      <h2 class="font-display text-3xl md:text-4xl mt-2 text-fg">
        Small things, made with care.
      </h2>
    </div>
    <span class="font-mono-ui text-[11px] text-muted hidden md:inline">
      {PROJECTS.length} selected
    </span>
  </div>

  <ul class="relative" id="projects-list">
    {
      PROJECTS.map((p, i) => (
        <li
          class="project-row group relative"
          data-rotation={i % 2 === 0 ? -2 : 2}
        >
          <a
            href={p.cta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="grid grid-cols-12 items-center gap-4 py-6 md:py-7"
          >
            <span class="col-span-1 font-mono-ui text-[11px] text-muted tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="col-span-7 md:col-span-5">
              <h3 class="font-display text-2xl md:text-3xl text-fg transition-transform duration-500 ease-out group-hover:translate-x-1">
                {p.title}
              </h3>
              <p class="font-mono-ui text-[11px] uppercase tracking-wider text-muted mt-1">
                {p.tag}
              </p>
            </div>
            <p class="hidden md:block col-span-4 text-sm text-muted leading-relaxed">
              {p.description}
            </p>
            <div class="col-span-4 md:col-span-2 flex items-center justify-end gap-3">
              <span class="font-mono-ui text-[11px] text-muted tabular-nums">
                {p.year}
              </span>
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-border bg-surface group-hover:bg-fg group-hover:text-bg transition-colors">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </span>
            </div>
          </a>

          <div
            class="pointer-events-none absolute right-6 md:right-12 w-48 md:w-64 aspect-4/3 rounded-lg overflow-hidden border border-border shadow-2xl z-60"
            style="top: 50%; opacity: 0; visibility: hidden; filter: blur(8px); transform: translate(14px, -50%) rotate(0deg) scale(0.92); transition: opacity 720ms cubic-bezier(0.16, 1, 0.3, 1), transform 820ms cubic-bezier(0.16, 1, 0.3, 1), filter 720ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 820ms;"
            data-preview
          >
            <Image
              src={p.image}
              alt=""
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const KEY_MAP = {
    a: "C4",
    s: "D4",
    d: "E4",
    f: "F4",
    g: "G4",
    h: "A4",
    j: "B4",
    k: "C5",
    l: "D5",
    ";": "E5",
    w: "C#4",
    e: "D#4",
    t: "F#4",
    y: "G#4",
    u: "A#4",
    o: "C#5",
    p: "D#5",
  };

  const heroPiano = document.getElementById("hero-piano");
  const pianoButtons = Array.from(
    heroPiano?.querySelectorAll<HTMLButtonElement>("[data-piano-key]") ?? [],
  );
  const pianoButtonsByNote = new Map(
    pianoButtons.map((button) => [button.dataset.note, button]),
  );
  let audioContext: AudioContext | null = null;

  function ensureAudioContext() {
    const AudioContextCtor =
      window.AudioContext || (window as any).webkitAudioContext;

    if (!AudioContextCtor) return null;

    audioContext ??= new AudioContextCtor();

    if (audioContext.state === "suspended") {
      void audioContext.resume();
    }

    return audioContext;
  }

  function playJazz(freq: number) {
    const ctx = ensureAudioContext();
    if (!ctx) return;

    const now = ctx.currentTime;
    const master = ctx.createGain();
    master.gain.setValueAtTime(0.0001, now);
    master.gain.exponentialRampToValueAtTime(0.2, now + 0.04);
    master.gain.exponentialRampToValueAtTime(0.0001, now + 1.9);
    master.connect(ctx.destination);

    const vib = ctx.createOscillator();
    vib.frequency.value = 5.5;

    const vibG = ctx.createGain();
    vibG.gain.value = 4;
    vib.connect(vibG);

    const o1 = ctx.createOscillator();
    o1.type = "triangle";
    o1.frequency.value = freq;

    const o2 = ctx.createOscillator();
    o2.type = "sine";
    o2.frequency.value = freq * 2;

    const o2g = ctx.createGain();
    o2g.gain.value = 0.12;

    vibG.connect(o1.frequency);
    vibG.connect(o2.frequency);

    const filter = ctx.createBiquadFilter();
    filter.type = "lowpass";
    filter.frequency.setValueAtTime(1700, now);
    filter.frequency.exponentialRampToValueAtTime(650, now + 1.6);

    o1.connect(filter);
    o2.connect(o2g).connect(filter);
    filter.connect(master);

    o1.start(now);
    o2.start(now);
    vib.start(now);
    o1.stop(now + 2);
    o2.stop(now + 2);
    vib.stop(now + 2);
  }

  function setActive(button: HTMLButtonElement) {
    button.dataset.active = "true";

    window.setTimeout(() => {
      delete button.dataset.active;
    }, 220);
  }

  function triggerPianoKey(button: HTMLButtonElement) {
    const freq = Number(button.dataset.freq);
    if (!Number.isFinite(freq)) return;

    playJazz(freq);
    setActive(button);
  }

  pianoButtons.forEach((button) => {
    button.addEventListener("pointerdown", (event) => {
      if (event.button > 0) return;

      event.preventDefault();
      triggerPianoKey(button);
    });
  });

  window.addEventListener("keydown", (event) => {
    if (event.repeat) return;

    const note = KEY_MAP[event.key.toLowerCase() as keyof typeof KEY_MAP];
    const button = pianoButtonsByNote.get(note);

    if (!button) return;

    event.preventDefault();
    triggerPianoKey(button);
  });

  const items = document.querySelectorAll<HTMLLIElement>("#projects-list li");

  items.forEach((item) => {
    const preview = item.querySelector<HTMLElement>("[data-preview]");
    const rotation = item.dataset.rotation ?? "0";

    item.addEventListener("mouseenter", () => {
      if (preview) {
        preview.style.visibility = "visible";
        preview.style.transitionDelay = "0s, 0s, 0s, 0s";
        preview.style.opacity = "1";
        preview.style.filter = "blur(0)";
        preview.style.transform = `translate(0, -50%) rotate(${rotation}deg) scale(1)`;
      }
    });

    item.addEventListener("mouseleave", () => {
      if (preview) {
        preview.style.opacity = "0";
        preview.style.filter = "blur(8px)";
        preview.style.visibility = "hidden";
        preview.style.transitionDelay = "0s, 0s, 0s, 820ms";
        preview.style.transform = `translate(14px, -50%) rotate(0deg) scale(0.92)`;
      }
    });
  });

  document
    .getElementById("projects-list")
    ?.addEventListener("mouseleave", () => {
      items.forEach((item) => {
        const preview = item.querySelector<HTMLElement>("[data-preview]");
        if (preview) {
          preview.style.opacity = "0";
          preview.style.filter = "blur(8px)";
          preview.style.visibility = "hidden";
          preview.style.transitionDelay = "0s, 0s, 0s, 820ms";
          preview.style.transform = `translate(14px, -50%) rotate(0deg) scale(0.92)`;
        }
      });
    });
</script>

---
import { Image } from "astro:assets";
import { SITE, PROJECTS, JOBS, BLOG_POSTS } from "../data/site";
---

<!-- Hero -->
<header class="flex flex-col gap-5">
  <h1
    class="font-heading ml-[-0.04em] m-0 text-[clamp(38px,6.4vw,58px)] leading-[1.06] font-bold tracking-[-0.02em]"
  >
    Hi, I'm Sourabh 👋
  </h1>
  <p
    class="m-0 text-[17px] leading-7 text-[color-mix(in_srgb,var(--color-ink)_78%,transparent)]"
  >
    Frontend engineer turning complex ideas into products people genuinely enjoy
    using. Happiest when a hard problem finally clicks, or when I'm losing
    gracefully at a video game. JK 😉. I don't lose often.
  </p>
  <div class="mt-2 grid sm:grid-cols-3 gap-3.5 grid-cols-1">
    <div class="group relative">
      <div
        class="bg-accent absolute inset-px rounded-md transition-transform duration-120 ease-[ease] group-hover:translate-x-0.75 group-hover:translate-y-0.75"
        aria-hidden="true"
      >
      </div>
      <a
        href={`mailto:${SITE.email}`}
        class="bg-ink text-paper border-ink font-heading relative flex w-full items-center justify-center gap-2.5 rounded-md border-2 px-5 py-3.25 text-[14px] font-bold tracking-[0.04em] uppercase transition-transform duration-120 ease-[ease] will-change-transform group-hover:-translate-x-0.75 group-hover:-translate-y-0.75"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="0"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        Email me
      </a>
    </div>
    <div class="group relative">
      <div
        class="bg-ink absolute inset-px rounded-md transition-transform duration-120 ease-[ease] group-hover:translate-x-0.5 group-hover:translate-y-0.5"
        aria-hidden="true"
      >
      </div>
      <a
        href={SITE.resumeHref}
        target="_blank"
        rel="noopener noreferrer"
        class="border-ink bg-paper font-heading relative flex w-full items-center justify-center gap-2.5 rounded-md border-2 px-5 py-3.25 text-[14px] font-bold tracking-[0.04em] uppercase transition-transform duration-120 ease-[ease] will-change-transform group-hover:-translate-x-0.75 group-hover:-translate-y-0.75 group-hover:text-accent"
      >
        Resume / CV
        <span class="sr-only">(opens in new tab)</span>
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>
    </div>
    <div class="group relative">
      <div
        class="bg-ink absolute inset-px rounded-md transition-transform duration-120 ease-[ease] group-hover:translate-x-0.75 group-hover:translate-y-0.75"
        aria-hidden="true"
      >
      </div>
      <a
        href="#projects"
        class="bg-accent border-accent font-heading relative flex w-full items-center justify-center gap-2.5 rounded-md border-2 px-5 py-3.25 text-[14px] font-bold tracking-[0.04em] text-[#f3f2f2] uppercase transition-transform will-change-transform duration-120 ease-[ease] group-hover:-translate-x-0.75 group-hover:-translate-y-0.75"
      >
        View projects
      </a>
    </div>
  </div>
</header>

<!-- About -->
<section id="about" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Who I am
  </h2>
  <div
    class="flex flex-col gap-5 text-[16px] leading-7 text-[color-mix(in_srgb,var(--color-ink)_82%,transparent)]"
  >
    <p class="m-0">
      I'm a <span class="text-ink font-extrabold"
        >frontend-focused engineer</span
      > with 2+ years of professional experience building modern web and mobile applications.
      Over the past couple of years, I've built products in {" "}
      <span class="bg-accent/25"> AdTech </span>, {" "}
      <span class="bg-accent/25"> trading </span>, and {" "}
      <span class="bg-accent/25"> affiliate marketing </span>, learning how to
      make complex products easier for people to use.
    </p>

    <p class="m-0">
      I like interfaces that feel a little
      <span class="text-ink font-extrabold"> handmade</span>, something that
      makes you pause for a second. Behind every polished screen is a series of
      small decisions and hard problems. That's the part I enjoy most.
    </p>

    <p class="m-0">
      I'm always chasing that point where thoughtful engineering fades into the
      background and all that's left is a product that simply <span
        class="text-ink font-extrabold">feels right to use.</span
      >
    </p>
  </div>
</section>

<!-- Skills -->
<section id="skills" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    What I work with
  </h2>

  <div class="relative">
    {/* Offset shadow */}
    <div
      class="absolute inset-0 translate-x-[7px] translate-y-[7px] rounded-[14px] bg-ink"
      aria-hidden="true"
    >
    </div>

    {/* Card */}
    <div
      class="relative overflow-hidden rounded-[14px] border-2 border-ink bg-panel"
    >
      {/* Header */}
      <div
        class="flex items-center justify-between border-b border-[rgba(243,242,242,0.15)] px-4 py-2.5"
      >
        <span class="font-mono text-[12px] text-[rgba(243,242,242,0.6)]">
          skills.ts
        </span>

        <div class="flex gap-1.5">
          <span class="h-2 w-2 bg-[rgba(243,242,242,0.25)]"></span>
          <span class="h-2 w-2 bg-[rgba(243,242,242,0.25)]"></span>
          <span class="bg-accent h-2 w-2"></span>
        </div>
      </div>

      {/* Code */}
      <div
        class="font-mono overflow-x-auto py-5 text-[14px] leading-6 text-[#f3f2f2] max-[640px]:text-[12.5px]"
      >
        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            1
          </span>

          <span class="whitespace-pre">
            <span class="text-accent font-bold">const</span>
            {" skills = {"}
          </span>
        </div>

        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            2
          </span>

          <span class="whitespace-pre">
            {"  frontend:  ["}
            <span class="text-accent">'React'</span>
            {", "}
            <span class="text-accent">'Next.js'</span>
            {", "}
            <span class="text-accent">'TypeScript'</span>
            {", "}
            <span class="text-accent">'Astro'</span>
            {"],"}
          </span>
        </div>

        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            3
          </span>

          <span class="whitespace-pre">
            {"  styling:   ["}
            <span class="text-accent">'Tailwind CSS'</span>
            {"],"}
          </span>
        </div>

        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            4
          </span>

          <span class="whitespace-pre">
            {"  animation: ["}
            <span class="text-accent">'GSAP'</span>
            {", "}
            <span class="text-accent">'Framer Motion'</span>
            {"],"}
          </span>
        </div>

        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            5
          </span>

          <span class="whitespace-pre">
            {"  state:     ["}
            <span class="text-accent">'TanStack Query'</span>
            {", "}
            <span class="text-accent">'Redux'</span>
            {", "}
            <span class="text-accent">'Zustand'</span>
            {"],"}
          </span>
        </div>

        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            6
          </span>

          <span class="whitespace-pre">
            {"  backend:   ["}
            <span class="text-accent">'Express.js'</span>
            {", "}
            <span class="text-accent">'MySQL'</span>
            {"],"}
          </span>
        </div>

        <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
          <span
            class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
          >
            7
          </span>

          <span class="whitespace-pre">
            {"} "}
            <span class="text-accent font-bold">as const</span>
            {";"}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Projects -->
<section id="projects" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Things I've built
  </h2>
  <div class="flex flex-col">
    {
      PROJECTS.map((project) => (
        <article class="group border-ink/15 grid grid-cols-[minmax(0,0.92fr)_minmax(0,1fr)] items-center gap-7.5 border-t-2 py-9.5 max-[640px]:grid-cols-1 max-[640px]:gap-5.5">
          <div class="relative">
            {/* Shadow */}
            <div
              class="bg-ink absolute inset-0 rounded-[14px] transition-transform duration-140 ease-[ease] group-hover:translate-x-0.75 group-hover:translate-y-0.75"
              aria-hidden="true"
            />

            {/* Card */}
            <figure class="border-ink relative m-0 w-full overflow-hidden rounded-[14px] border-2 transition-transform duration-140 ease-[ease] group-hover:-translate-x-0.75 group-hover:-translate-y-0.75 will-change-transform">
              <Image
                src={project.imgSrc}
                alt={project.title}
                loading="lazy"
                decoding="async"
                quality="mid"
                class="aspect-4/3 w-full object-cover"
              />
            </figure>
          </div>
          <div class="flex min-w-0 flex-col gap-3">
            <h3 class="font-heading text-ink m-0 text-[26px] leading-[1.08] font-bold tracking-[-0.015em] transition-colors duration-140 ease-[ease] group-hover:text-accent">
              {project.title}
            </h3>
            <p class="m-0 text-[15px] leading-[26px] text-[color-mix(in_srgb,var(--color-ink)_78%,transparent)]">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-1.75 pt-0.5">
              {project.tags.map((tag) => (
                <span class="text-tag-ink rounded-full bg-[rgba(236,48,19,0.14)] px-2.5 py-1 text-[11px] tracking-wide">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex gap-2.5 pt-2">
              <a
                href={project.codeHref}
                aria-label={`View code for ${project.title}`}
                class="border-ink text-ink inline-flex h-9 w-9 items-center justify-center rounded-full border-2 transition-colors duration-120 ease-[ease] hover:bg-ink hover:text-paper"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.16.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.16a10.9 10.9 0 0 1 5.72 0c2.18-1.47 3.14-1.16 3.14-1.16.62 1.57.23 2.73.11 3.02.73.79 1.17 1.8 1.17 3.04 0 4.35-2.65 5.31-5.18 5.59.41.35.77 1.04.77 2.11 0 1.52-.01 2.75-.01 3.12 0 .3.2.66.79.55 4.51-1.51 7.77-5.76 7.77-10.78C23.02 5.24 18.27.5 12 .5Z" />
                </svg>
                <span class="sr-only">(opens in new tab)</span>
              </a>
              <a
                href={project.visitHref}
                aria-label={`Visit live site for ${project.title}`}
                class="border-ink text-ink inline-flex h-9 w-9 items-center justify-center rounded-full border-2 transition-colors duration-120 ease-[ease] hover:border-accent hover:bg-accent hover:text-paper"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />
                </svg>
                <span class="sr-only">(opens in new tab)</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<!-- Experience -->
<section id="experience" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Where I've been
  </h2>
  <div class="flex flex-col">
    {
      JOBS.map((job) => (
        <div class="border-ink/20 grid grid-cols-[140px_1fr] gap-x-6 gap-y-2 border-t-2 py-6 max-[640px]:grid-cols-1 max-[640px]:gap-1.5">
          <p class="m-0 text-[13px] leading-5.5 text-[color-mix(in_srgb,var(--color-ink)_55%,transparent)] font-features-['tnum'_1]">
            {job.dates}
          </p>
          <div class="flex flex-col gap-1.5">
            <p class="font-heading m-0 text-[16px] font-bold">
              {job.role} · {job.company}
            </p>
            <p class="m-0 text-[14px] leading-6 text-[color-mix(in_srgb,var(--color-ink)_70%,transparent)]">
              {job.summary}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Writing -->
<section id="writing" class="pt-18 max-[640px]:pt-14">
  <div class="mb-7 flex flex-wrap items-baseline justify-between gap-4.5">
    <h2
      class="font-heading m-0 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
    >
      <span aria-hidden="true" class="text-[0.85em]">📌</span>
      What I've written
    </h2>
    <a
      href="/blog"
      class="group font-heading text-ink inline-flex items-center gap-1 text-[13px] font-bold tracking-[0.06em] uppercase underline decoration-2 underline-offset-4 transition-colors duration-150 ease-[ease] hover:text-accent"
    >
      All posts
    </a>
  </div>
  <div class="grid grid-cols-3 gap-3.5 max-[720px]:grid-cols-1">
    {
      BLOG_POSTS.map((post) => (
        <div class="group relative">
          <div
            class="bg-ink absolute inset-px rounded-[14px] transition-transform duration-120 ease-[ease] group-hover:translate-x-0.75 group-hover:translate-y-0.75"
            aria-hidden="true"
          />
          <a
            href={`/blog/${post.slug}`}
            class="border-ink bg-paper relative flex h-full w-full flex-col gap-2.25 rounded-[14px] border-2 p-5 transition-transform duration-120 ease-[ease] group-hover:-translate-x-0.75 group-hover:-translate-y-0.75 will-change-transform"
          >
            <span class="font-heading flex items-center justify-between gap-2.5 text-[10.5px] font-semibold tracking-[0.12em] text-[color-mix(in_srgb,var(--color-ink)_50%,transparent)] uppercase">
              {post.date}
              <span class="inline-flex items-center gap-1.25">
                <span
                  aria-hidden="true"
                  class="bg-accent h-1.25 w-1.25 rounded-full"
                />
                {post.read}
              </span>
            </span>
            <span class="font-heading text-ink line-clamp-2 text-[17px] leading-[1.24] font-bold transition-colors duration-140 ease-[ease] group-hover:text-accent">
              {post.title}
            </span>
            <span class="line-clamp-3 text-[13.5px] leading-5.5 text-[color-mix(in_srgb,var(--color-ink)_68%,transparent)]">
              {post.excerpt}
            </span>
            <span
              aria-hidden="true"
              class="mt-auto pt-1.5 text-[15px] opacity-30 transition-[translate,opacity] duration-140 ease-[ease] group-hover:translate-x-0.75 group-hover:opacity-75"
            >
              →
            </span>
          </a>
        </div>
      ))
    }
  </div>
</section>

<!-- Contact -->
<section id="contact" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Let's talk
  </h2>
  <div class="relative">
    <div
      class="bg-ink absolute inset-0 translate-x-1.75 translate-y-1.75 rounded-[18px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="border-ink bg-accent text-paper relative rounded-[18px] border-[3px]"
    >
      <div class="px-6 py-9 max-[640px]:px-5 max-[640px]:py-7">
        <h3
          class="font-heading ml-[-0.04em] m-0 mb-4 text-[clamp(28px,4.5vw,44px)] leading-[1.02] font-bold tracking-[-0.01em] uppercase"
        >
          Let's build<br />something.
        </h3>
        <p class="font-heading m-0 mb-6 text-[15px] font-bold">
          The fastest way to reach me is email. I read everything, even the
          weird ones.
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="bg-ink text-paper border-ink hover:bg-paper hover:text-ink font-heading inline-flex items-center gap-2 rounded-[10px] border-2 px-6 py-4 sm:text-[15px] text-[11px] font-bold tracking-[0.06em] uppercase"
        >
          {SITE.email}
          <svg
            class="w-[13px] h-[13px] sm:w-[18px] sm:h-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Try the system mail client first; if nothing takes focus within 600ms,
  // fall back to opening the compose window in Gmail's web UI.
  document
    .querySelectorAll<HTMLAnchorElement>("a[href^='mailto:']")
    .forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const mailto = link.href;
        const email = mailto.replace("mailto:", "");
        const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}`;

        window.location.href = mailto;

        setTimeout(() => {
          if (document.hasFocus()) {
            window.open(gmail, "_blank", "noopener,noreferrer");
          }
        }, 600);
      });
    });
</script>

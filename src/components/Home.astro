---
import Image from "astro/components/Image.astro";
import { SITE, PROJECTS, JOBS } from "../data/site";
---

<!-- Hero -->
<header class="flex flex-col gap-5">
  <h1
    class="font-heading ml-[-0.04em] m-0 text-[clamp(38px,6.4vw,58px)] leading-[1.06] font-bold tracking-[-0.02em]"
  >
    Hi, I'm Sourabh 👋
  </h1>
  <p
    class="m-0 text-[17px] leading-7 text-[color-mix(in_srgb,var(--color-ink)_78%,transparent)]"
  >
    Frontend engineer turning complex ideas into products people genuinely enjoy
    using. Happiest when a hard problem finally clicks, or when I'm losing
    gracefully at a video game. JK 😉. I don't lose often.
  </p>
  <div class="mt-2 grid sm:grid-cols-3 gap-3.5 grid-cols-1">
    <a
      href={`mailto:${SITE.email}`}
      class="bg-ink text-paper border-ink relative inline-flex items-center justify-center gap-2.5 border-2 px-5 py-3.25 text-[14px] font-bold tracking-[0.04em] uppercase no-underline transition-[translate,box-shadow] duration-120 ease-[ease] before:absolute before:-inset-0.75 before:content-[''] hover:-translate-x-0.75 hover:-translate-y-0.75 hover:text-paper hover:shadow-[6px_6px_0_var(--color-accent)] font-heading"
    >
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="20" height="16" x="2" y="4" rx="0"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      Email me
    </a>
    <a
      href={SITE.resumeHref}
      target="_blank"
      rel="noopener noreferrer"
      class="border-ink font-heading relative inline-flex items-center justify-center gap-2.5 border-2 px-5 py-3.25 text-[14px] font-bold tracking-[0.04em] uppercase no-underline transition-[translate,box-shadow] duration-120 ease-[ease] before:absolute before:-inset-0.75 before:content-[''] hover:-translate-x-0.75 hover:-translate-y-0.75 hover:text-accent hover:shadow-[6px_6px_0_var(--color-ink)]"
    >
      Resume / CV
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </a>
    <a
      href="#projects"
      class="bg-accent border-accent font-heading relative inline-flex items-center justify-center gap-2.5 border-2 px-5 py-3.25 text-[14px] font-bold tracking-[0.04em] text-[#f3f2f2] uppercase no-underline transition-[translate,box-shadow] duration-120 ease-[ease] before:absolute before:-inset-0.75 before:content-[''] hover:-translate-x-0.75 hover:-translate-y-0.75 hover:text-[#f3f2f2] hover:shadow-[6px_6px_0_var(--color-ink)]"
    >
      View projects
    </a>
  </div>
</header>

<!-- About -->
<section id="about" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Who I am
  </h2>
  <div
    class="flex flex-col gap-5 text-[16px] leading-7 text-[color-mix(in_srgb,var(--color-ink)_82%,transparent)]"
  >
    <p class="m-0">
      I'm a <span class="text-ink font-extrabold"
        >frontend-focused engineer</span
      > with 2+ years of professional experience building modern web and mobile applications.
      Over the past couple of years, I've built products in {" "}
      <span class="bg-accent/25"> AdTech </span>, {" "}
      <span class="bg-accent/25"> trading </span>, and {" "}
      <span class="bg-accent/25"> affiliate marketing </span>, learning how to
      make complex products easier for people to use.
    </p>

    <p class="m-0">
      I like interfaces that feel a little
      <span class="text-ink font-extrabold"> handmade</span>, something that
      makes you pause for a second. Behind every polished screen is a series of
      small decisions and hard problems. That's the part I enjoy most.
    </p>

    <p class="m-0">
      I'm always chasing that point where thoughtful engineering fades into the
      background and all that's left is a product that simply <span
        class="text-ink font-extrabold">feels right to use.</span
      >
    </p>
  </div>
</section>

<!-- Skills -->
<section id="skills" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    What I work with
  </h2>

  <div class="border-ink bg-panel border-2 shadow-[7px_7px_0_var(--color-ink)]">
    <div
      class="flex items-center justify-between border-b border-[rgba(243,242,242,0.15)] px-4 py-2.5"
    >
      <span class="font-mono text-[12px] text-[rgba(243,242,242,0.6)]">
        skills.ts
      </span>

      <div class="flex gap-1.5">
        <span class="h-2 w-2 bg-[rgba(243,242,242,0.25)]"></span>
        <span class="h-2 w-2 bg-[rgba(243,242,242,0.25)]"></span>
        <span class="bg-accent h-2 w-2"></span>
      </div>
    </div>

    <div
      class="font-mono overflow-x-auto py-5 text-[14px] leading-6 text-[#f3f2f2] max-[640px]:text-[12.5px]"
    >
      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          1
        </span>

        <span class="whitespace-pre">
          <span class="text-accent font-bold">const</span>{" skills = {"}
        </span>
      </div>

      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          2
        </span>

        <span class="whitespace-pre">
          {"  frontend:  ["}
          <span class="text-accent">'React'</span>{", "}
          <span class="text-accent">'Next.js'</span>{", "}
          <span class="text-accent">'TypeScript'</span>{", "}
          <span class="text-accent">'Astro'</span>
          {"],"}
        </span>
      </div>

      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          3
        </span>

        <span class="whitespace-pre">
          {"  styling:   ["}
          <span class="text-accent">'Tailwind CSS'</span>
          {"],"}
        </span>
      </div>

      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          4
        </span>

        <span class="whitespace-pre">
          {"  animation: ["}
          <span class="text-accent">'GSAP'</span>{", "}
          <span class="text-accent">'Framer Motion'</span>
          {"],"}
        </span>
      </div>

      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          5
        </span>

        <span class="whitespace-pre">
          {"  state:     ["}
          <span class="text-accent">'TanStack Query'</span>{", "}
          <span class="text-accent">'Redux'</span>{", "}
          <span class="text-accent">'Zustand'</span>
          {"],"}
        </span>
      </div>

      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          6
        </span>

        <span class="whitespace-pre">
          {"  backend:   ["}
          <span class="text-accent">'Express.js'</span>{", "}
          <span class="text-accent">'MySQL'</span>
          {"],"}
        </span>
      </div>

      <div class="flex gap-5 px-4 hover:bg-[rgba(243,242,242,0.07)]">
        <span
          class="w-4 shrink-0 select-none text-right text-[rgba(243,242,242,0.25)]"
        >
          7
        </span>

        <span class="whitespace-pre">
          {"} "}
          <span class="text-accent font-bold">as const</span>
          {";"}
        </span>
      </div>
    </div>
  </div>
</section>

<!-- Projects -->
<section id="projects" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Things I've built
  </h2>
  <div class="flex flex-col gap-14">
    {
      PROJECTS.map((project) => (
        <article class="flex flex-col gap-4">
          <div class="group relative before:absolute before:-inset-0.75 before:content-['']">
            <figure class="border-ink m-0 overflow-hidden border-2 transition-[translate,box-shadow] duration-120 ease-[ease] group-hover:-translate-x-0.75 group-hover:-translate-y-0.75 group-hover:shadow-[7px_7px_0_var(--color-ink)]">
              <div class="font-heading flex aspect-video w-full items-center justify-center bg-[color-mix(in_srgb,var(--color-ink)_6%,var(--color-paper))] text-[12px] tracking-[0.04em] text-[color-mix(in_srgb,var(--color-ink)_45%,transparent)] uppercase">
                <Image
                  src={project.imgSrc}
                  alt={project.title}
                  width={800}
                  height={450}
                />
              </div>
            </figure>
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h3 class="font-heading m-0 text-[20px] font-bold">
              {project.title}
            </h3>
            <span class="flex items-baseline gap-5">
              <a
                href={project.codeHref}
                class="border-ink hover:border-accent hover:text-accent border-b-2 pb-0.5 text-[13px] tracking-[0.06em] uppercase no-underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                Code
              </a>
              <a
                href={project.visitHref}
                class="border-ink hover:border-accent hover:text-accent border-b-2 pb-0.5 text-[13px] tracking-[0.06em] uppercase no-underline inline-flex items-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </a>
            </span>
          </div>
          <p class="m-0 max-w-[65ch] text-[15px] leading-6 text-[color-mix(in_srgb,var(--color-ink)_78%,transparent)]">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="text-tag-ink px-2.5 py-1 text-[12px] tracking-wider bg-[rgba(236,48,19,0.14)]">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<!-- Experience -->
<section id="experience" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Where I've been
  </h2>
  <div class="flex flex-col">
    {
      JOBS.map((job) => (
        <div class="border-ink/20 grid grid-cols-[140px_1fr] gap-x-6 gap-y-2 border-t-2 py-6 max-[640px]:grid-cols-1 max-[640px]:gap-1.5">
          <p class="m-0 text-[13px] leading-5.5 text-[color-mix(in_srgb,var(--color-ink)_55%,transparent)] font-features-['tnum'_1]">
            {job.dates}
          </p>
          <div class="flex flex-col gap-1.5">
            <p class="font-heading m-0 text-[16px] font-bold">
              {job.role} · {job.company}
            </p>
            <p class="m-0 text-[14px] leading-6 text-[color-mix(in_srgb,var(--color-ink)_70%,transparent)]">
              {job.summary}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Contact -->
<section id="contact" class="pt-18 max-[640px]:pt-14">
  <h2
    class="font-heading m-0 mb-7 flex items-center gap-3 text-[26px] font-bold tracking-[-0.01em]"
  >
    <span aria-hidden="true" class="text-[0.85em]">📌</span>
    Let's talk
  </h2>
  <div
    class="border-ink bg-accent text-paper border-[3px] shadow-[8px_8px_0_var(--color-ink)]"
  >
    <div class="px-6 py-9 max-[640px]:px-5 max-[640px]:py-7">
      <h3
        class="font-heading ml-[-0.04em] m-0 mb-4 text-[clamp(28px,4.5vw,44px)] leading-[1.02] font-bold tracking-[-0.01em] uppercase"
      >
        Let's build<br />something.
      </h3>
      <p class="font-heading m-0 mb-6 text-[15px] font-bold">
        The fastest way to reach me is email. I read everything, even the weird
        ones.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="bg-ink text-paper border-ink hover:bg-paper hover:text-ink font-heading inline-flex items-center gap-2 border-2 px-6 py-4 sm:text-[15px] text-[11px] font-bold tracking-[0.06em] uppercase no-underline"
      >
        {SITE.email}
        <svg
          class="w-[13px] h-[13px] sm:w-[18px] sm:h-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Try the system mail client first; if nothing takes focus within 600ms,
  // fall back to opening the compose window in Gmail's web UI.
  document
    .querySelectorAll<HTMLAnchorElement>("a[href^='mailto:']")
    .forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const mailto = link.href;
        const email = mailto.replace("mailto:", "");
        const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}`;

        window.location.href = mailto;

        setTimeout(() => {
          if (document.hasFocus()) {
            window.open(gmail, "_blank", "noopener,noreferrer");
          }
        }, 600);
      });
    });
</script>
